# Required. Origin of the FastAPI backend.
# Physical phone (Expo Go): use your computer's LAN IP, for example:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:8000
# Do not use localhost, 127.0.0.1, or 10.0.2.2 on a physical device.
# The phone and computer must be on the same Wi-Fi, and FastAPI must listen
# on 0.0.0.0 (not only 127.0.0.1).
EXPO_PUBLIC_API_BASE_URL=

# Required. Must match an existing User.id in the backend database.
EXPO_PUBLIC_DEV_USER_ID=
